<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jangan rewrite file index.html itu sendiri
  RewriteRule ^index\.html$ - [L]

  # Jika file atau folder fisik ada (seperti /assets/*), sajikan langsung
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Arahkan semua route lainnya ke index.html (SPA Routing)
  RewriteRule . /index.html [L]
</IfModule>

# Pastikan index.html selalu mengambil versi terbaru (Anti-Stale Cache saat update)
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache file aset statis (JS/CSS dengan hash) agar loading super cepat
  <FilesMatch "\.(js|css|woff2?|ttf|svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Kompresi Gzip untuk mempercepat muatan halaman di mobile & desktop
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
